 "titolo": "La fermata che non c'è",
 "righe": [
  {
   "id": 1,
   "voce": "È l'ultima metro della notte. E faresti meglio a perderla.",
   "img": "s01_scala.png",
   "mov": "corsa",
   "corsa": true
  },
  {
   "id": 2,
   "voce": "Invece corri. Le porte si chiudono, e un ombrello rosso le blocca.",
   "img": "s02_ombrello_porte.png",
   "mov": "avanza"
  },
  {
   "id": 3,
   "voce": "Sali. «Prego», dice un uomo. «Tanto io scendo alla prossima.»",
   "img": "s03_uomo_c.png",
   "mov": "mano"
  },
  {
   "id": 4,
   "voce": "Ti siedi. Quattro passeggeri, nessuno alza la testa.",
   "img": "s04_vagone_b.png",
   "mov": "avanza_lento"
  },
  {
   "id": 5,
   "voce": "Poi il treno frena, e si ferma.",
   "img": "s05_finestrino.png",
   "mov": "fermo",
   "galleria": true
  },
  {
   "id": 6,
   "voce": "Guardi la mappa. Qui non c'è nessuna fermata.",
   "img": "s06_mappa.png",
   "mov": "avanza_lento",
   "lampeggia": true
  },
  {
   "id": 7,
   "voce": "Le porte si aprono su una banchina di cemento.",
   "img": "s07_banchina.png",
   "mov": "avanza_lento",
   "neon": 0.6,
   "vapore": [
    0.5,
    0.5,
    0.18
   ],
   "porte": "aprono"
  },
  {
   "id": 8,
   "voce": "Un neon. Un cartello bianco, senza nome.",
   "img": "s08_neon_cartello.png",
   "mov": "avanza_lento",
   "neon": 0.8
  },
  {
   "id": 9,
   "voce": "Nessuno sale.",
   "img": "s09_soglia.png",
   "mov": "fermo",
   "neon": 0.6
  },
  {
   "id": 10,
   "voce": "",
   "silenzio": 1.2,
   "img": "s09_soglia.png",
   "mov": "fermo",
   "neon": 0.6
  },
  {
   "id": 11,
   "voce": "Nel vagone nessuno guarda fuori.",
   "img": "s11_passeggeri.png",
   "mov": "panoramica"
  },
  {
   "id": 12,
   "voce": "Un vecchio alza il giornale un po' di più.",
   "img": "s12_giornale.png",
   "mov": "avanza_lento",
   "alza": true
  },
  {
   "id": 13,
   "voce": "L'uomo appende l'ombrello accanto a te. E scende.",
   "img": "s13_ombrello_appeso.png",
   "mov": "mano"
  },
  {
   "id": 14,
   "voce": "Sparisce nel buio, senza voltarsi. Le porte restano aperte.",
   "img": "s14_sagoma.png",
   "mov": "avanza_lento",
   "neon": 0.6,
   "sparisce": true
  },
  {
