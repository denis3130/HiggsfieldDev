   "speciale": "risveglio"
  },
  {
   "id": 3,
   "voce": "Apri gli occhi. Sono le tre e nove di notte.",
   "img": "s02_mano_telefono.png",
   "mov": "mano",
   "schermo": "blocco",
   "schermo_dopo": 1.38
  },
  {
   "id": 4,
   "voce": "Milano, nono piano. Nel palazzo siete rimasti in pochi: lo stanno svuotando.",
   "img": "s03_torre.png",
   "speciale": "sali"
  },
  {
   "id": 5,
   "voce": "Altri tre colpi. Ti alzi.",
   "img": "s04_piedi.png",
   "mov": "mano"
  },
  {
   "id": 6,
   "voce": "Il corridoio è buio. Arrivi alla porta.",
