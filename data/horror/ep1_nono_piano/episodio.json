   "mov": "avanza",
   "tuffo": true
  },
  {
   "id": 8,
   "voce": "Il pianerottolo è illuminato. Deserto. Davanti alla tua porta non c'è nessuno.",
   "img": "s07_pianerottolo.png",
   "mov": "fermo",
   "neon": true
  },
  {
   "id": 9,
   "voce": "Gridi:",
