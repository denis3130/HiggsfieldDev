   "mov": "fermo"
  },
  {
   "id": 11,
   "voce": "Poi il telefono vibra.",
   "img": "s10_telefono_mano.png",
   "mov": "mano"
  },
  {
   "id": 12,
   "voce": "Un numero sconosciuto:",
   "citazione": "Lo so che sei sveglio. Apri.",
   "schermo": "messaggio",
   "speciale": "messaggio"
  },
  {
   "id": 13,
   "voce": "Fai un passo indietro. E lo senti: tre colpi. Non dalla porta.",
