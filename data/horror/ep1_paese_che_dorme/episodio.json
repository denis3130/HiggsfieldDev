   "mov": "fermo",
   "vapore": [
    0.42,
    0.42,
    0.2
   ],
   "effetto": "fuoco"
  },
  {
   "id": 7,
   "voce": "Le nove. La campana.",
   "img": "s08_campanile.png",
   "mov": "fermo",
   "effetto": "orologio"
  },
  {
   "id": 8,
   "voce": "Sotto di te ogni porta si sbarra. Ogni luce si spegne.",
   "img": "s09_via_alto.png",
   "mov": "avanza_lento",
   "effetto": "via"
  },
  {
   "id": 9,
   "voce": "",
   "silenzio": 2.2,
   "img": "s09_via_alto.png",
   "mov": "avanza_lento",
   "effetto": "via"
  },
  {
   "id": 10,
   "voce": "Poi, dalla nebbia, i campanacci.",
   "img": "s09_via_alto.png",
   "mov": "avanza_lento",
   "effetto": "via"
  },
  {
   "id": 11,
   "voce": "Salgono in fila, lenti. Mantelli neri. Volti di legno, senza bocca.",
   "img": "s12_fila_b.png",
   "mov": "avanza_lento",
   "stacco": {
    "parola": "Volti",
    "img": "s12_volto_c.png",
    "mov": "avanza"
   }
  },
  {
   "id": 12,
   "voce": "Uno si ferma sotto la tua finestra. E alza la testa.",
   "img": "s13_sotto_b.png",
   "mov": "avanza"
  },
  {
   "id": 13,
   "voce": "Giù, alla porta: tre colpi.",
   "img": "s14_scala.png",
