 "righe": [
  {
   "id": 1,
   "voce": "Tra cinque minuti, in questo paese, non ti risponderà più nessuno.",
   "img": "s01_via.png",
   "mov": "avanza"
  },
  {
   "id": 2,
   "voce": "Ti hanno chiamato per riparare l'orologio del campanile.",
   "img": "s02_lettera.png",
   "mov": "mano"
  },
  {
   "id": 3,
   "voce": "Stanotte è la festa dei Muti. Alla locanda non c'è nessuno.",
   "img": "s03_ingresso.png",
   "mov": "avanza"
  },
  {
   "id": 4,
   "voce": "Sul bancone, una chiave e un biglietto:",
   "citazione": "Qualunque cosa senti, non uscire.",
   "img": "s04_bancone.png",
   "mov": "scendi",
   "stacco": {
    "parola": "Qualunque",
    "img": "s05_biglietto.png",
    "mov": "fermo"
   }
  },
  {
   "id": 5,
   "voce": "In camera la stufa è accesa.",
   "img": "s06_stufa.png",
   "mov": "avanza_lento",
   "effetto": "fuoco"
  },
  {
   "id": 6,
   "voce": "Eppure il fiato ti si gela.",
