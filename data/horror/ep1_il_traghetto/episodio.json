 "righe": [
  {
   "id": 1,
   "voce": "Hai un biglietto per la Sardegna. Non ci arriverai.",
   "img": "s01_biglietti_scritte.png",
   "mov": "avanza_lento"
  },
  {
   "id": 2,
   "voce": "Livorno, ultima nave della sera. Sali a bordo con tuo padre.",
   "img": "s02_rampa.png",
   "mov": "mano"
  },
  {
   "id": 3,
   "voce": "In cabina, lui si addormenta subito. Tu no.",
   "img": "s03_cabina.png",
   "mov": "fermo",
   "rollio": true
  },
  {
   "id": 4,
   "voce": "Prendi la tessera.",
   "img": "s04_tessera_scritte.png",
   "mov": "avanza"
  },
  {
   "id": 5,
   "voce": "Esci sul ponte.",
   "img": "s05_porta_ponte.png",
   "mov": "avanza"
  },
  {
   "id": 6,
   "voce": "Fuori c'è solo nebbia.",
   "img": "s06_ponte_nebbia.png",
   "mov": "avanza_lento"
  },
  {
   "id": 7,
   "voce": "Dalla nebbia esce un'altra nave. Identica alla tua. Spenta. Vuota.",
   "img": "s07_nave_spenta.png",
   "mov": "panoramica"
  },
  {
   "id": 8,
   "voce": "Ti sfiora in silenzio. E sparisce.",
   "img": "s08_poppa_nebbia_scritte.png",
   "mov": "avanza_lento",
   "sparisce": true
  },
  {
   "id": 9,
   "voce": "Il salone era pieno. Adesso non c'è nessuno. Nemmeno una valigia.",
   "img": "s09_salone.png",
   "mov": "avanza"
  },
  {
   "id": 10,
   "voce": "Corri alla cabina. La tessera non apre più.",
   "img": "s10_serratura_scritte.png",
   "mov": "mano",
   "led": [
    500,
    597,
    8
   ]
  },
  {
