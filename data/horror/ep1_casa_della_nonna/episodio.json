   "mov": "fermo"
  },
  {
   "id": 4,
   "voce": "La nonna è morta da due settimane. La casa va svuotata.",
   "img": "s04_soffitta.png",
   "mov": "panoramica"
  },
  {
   "id": 5,
   "voce": "Giri le pagine. Il pozzo. La quercia. Sei sempre tu.",
