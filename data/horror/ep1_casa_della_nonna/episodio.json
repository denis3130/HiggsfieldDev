   "mov": "avanza",
   "scurisci": [
    0.06,
    0.56,
    0.14,
    0.08
   ]
  },
  {
   "id": 10,
   "voce": "Guardi nella serratura. C'è la chiave. Infilata dall'altra parte.",
   "img": "s10_serratura.png",
   "mov": "avanza"
  },
  {
   "id": 11,
   "voce": "Chiusa da dentro. E in casa non dovrebbe esserci nessuno.",
   "img": "s11_fessura.png",
   "mov": "fermo"
  },
  {
   "id": 12,
   "voce": "Appoggi la mano sulla maniglia.",
