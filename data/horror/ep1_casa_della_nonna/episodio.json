  {
   "id": 7,
   "voce": "Poi, da sotto, un rumore.",
   "img": "s07_botola.png",
   "mov": "fermo"
  },
  {
   "id": 8,
   "voce": "Scendi. I piedi conoscono ogni gradino.",
   "img": "s08_scale.png",
   "mov": "scendi"
  },
  {
   "id": 9,
   "voce": "In cucina, la porta della cantina è chiusa.",
